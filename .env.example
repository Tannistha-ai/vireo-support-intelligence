# Copy to .env (never commit .env).
LLM_PROVIDER=ollama          # ollama | gemini | mock
OLLAMA_MODEL=llama3.2        # small local model (~2GB). Alternatives: gemma3, phi4-mini
GEMINI_API_KEY=              # only needed if you also test gemini (aistudio.google.com/apikey)
GEMINI_MODEL=gemini-2.5-flash-lite
